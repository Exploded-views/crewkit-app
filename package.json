{
  "name": "crewkit-app",
  "version": "0.1.0",
  "private": true,
  "description": "A light macOS menu-bar front end for crewkit and its crews",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "tauri": "tauri",
    "test": "vitest run --config ui/vite.config.ts",
    "test:coverage": "vitest run --config ui/vite.config.ts --coverage",
    "test:tools": "node --test tools/*.test.ts",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.json",
    "knip": "knip",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;Zlib;Unicode-3.0'",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "6.16.1"
  },
  "dependencies": {
    "svelte": "5.57.2"
  }
}
